#!/bin/bash
set -euo pipefail

QT_VERSION=6.12.0
QT_DIR="/home/work/fs_Qt/$QT_VERSION/gcc_64"
export PATH="$QT_DIR/bin/:$PATH"
export LD_LIBRARY_PATH="$QT_DIR/lib/:${LD_LIBRARY_PATH:-}"

if [ -x "$QT_DIR/bin/qmake" ]; then
  export QMAKE="$QT_DIR/bin/qmake"
elif command -v qmake6 >/dev/null 2>&1; then
  export QMAKE="$(command -v qmake6)"
elif command -v qmake >/dev/null 2>&1; then
  export QMAKE="$(command -v qmake)"
fi

DST=~/DABstarAppImage
LINUXDEPLOY="linuxdeploy-x86_64.AppImage"
LINUXDEPLOY_PLUGIN_QT="linuxdeploy-plugin-qt-x86_64.AppImage"
LINUXDEPLOY_PLUGIN_APPIMAGE="linuxdeploy-plugin-appimage-x86_64.AppImage"

mkdir -p "$DST"

mkdir -p "$DST/appdir/usr/bin"
mkdir -p "$DST/appdir/usr/lib"
mkdir -p "$DST/appdir/usr/share/applications"
mkdir -p "$DST/appdir/usr/share/icons/hicolor/256x256/apps/"

cp dabstar.desktop              "$DST/appdir/usr/share/applications/"
cp ../../res/logo/dabstar.png   "$DST/appdir/usr/share/icons/hicolor/256x256/apps/"
if [ -f /usr/local/lib/librtlsdr.so ]; then
  cp -d /usr/local/lib/librtlsdr.so* "$DST/appdir/usr/lib/" || true
fi

cd "$DST"

# from here the build folder with the build has to exist in the folder $DST
cp build/dabstar appdir/usr/bin/

wget -q --show-progress -c "https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/$LINUXDEPLOY"
wget -q --show-progress -c "https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/continuous/$LINUXDEPLOY_PLUGIN_QT"
wget -q --show-progress -c "https://github.com/linuxdeploy/linuxdeploy-plugin-appimage/releases/download/continuous/$LINUXDEPLOY_PLUGIN_APPIMAGE"

chmod a+x "$LINUXDEPLOY" "$LINUXDEPLOY_PLUGIN_QT" "$LINUXDEPLOY_PLUGIN_APPIMAGE"

# Official Qt distributions bundle all SQL drivers (e.g., Oracle OCI, Mimer, Firebird)
# which dynamically link to vendor libraries (e.g., libclntsh.so, libmimerapi.so).
# linuxdeploy-plugin-qt attempts to deploy all plugins and aborts if any dependency is missing.
# Create dummy stubs for missing third-party driver dependencies to satisfy resolution.
STUB_DIR=$(mktemp -d)
trap 'rm -rf "$STUB_DIR"' EXIT

QT_PLUGINS_DIR="$QT_DIR/plugins"
if [ -d "$QT_PLUGINS_DIR" ]; then
  while IFS= read -r lib; do
    if [ -n "$lib" ]; then
      gcc -shared -fPIC -o "$STUB_DIR/$lib" -x c /dev/null 2>/dev/null || true
    fi
  done < <(ldd "$QT_PLUGINS_DIR"/*/*.so 2>/dev/null \
            | awk '/not found/ && !/libQt/ {print $1}' \
            | sort -u)
fi

export LD_LIBRARY_PATH="$STUB_DIR:${LD_LIBRARY_PATH:-}"

APP_NAME="@PROJECT_NAME@"
APP_VERS="@PROJECT_VERSION@"
APP_ARCH="x86_64"
FN_DST="${APP_NAME}-${APP_VERS}-${APP_ARCH}.AppImage"

export VERSION="$APP_VERS"
export LDAI_OUTPUT="$FN_DST"
export EXTRA_QT_MODULES="sql;multimedia;charts;network;xml;widgets"
export DISABLE_COPYRIGHT_FILES_DEPLOYMENT=1

# Execute linuxdeploy with the Qt plugin to deploy dependencies and package the AppImage
if ./"$LINUXDEPLOY" \
    --appdir appdir \
    -e appdir/usr/bin/dabstar \
    -d appdir/usr/share/applications/dabstar.desktop \
    -i appdir/usr/share/icons/hicolor/256x256/apps/dabstar.png \
    --plugin qt \
    --output appimage; then
  echo "linuxdeploy runs successfully"
  if [ ! -f "$FN_DST" ]; then
    FN_SRC=$(ls -1 "${APP_NAME}"*.AppImage 2>/dev/null | grep -v "${FN_DST}" | head -n 1 || true)
    if [ -n "$FN_SRC" ] && [ -f "$FN_SRC" ]; then
      mv -f -v "$FN_SRC" "$FN_DST"
    fi
  fi
else
  echo "linuxdeploy failed"
  exit 1
fi
